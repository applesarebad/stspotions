---
import "../styles/global.css";
import Mapicon from "../components/mapicon.astro";
import mapElite from "../assets/map_elite.png";
import mapEnemy from "../assets/map_monster.png";
import mapEvent from "../assets/map_unknown.png";
import mapEventEnemy from "../assets/map_unknown_monster.png";
import potion from "../assets/block_potion.png";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.ico" />
		<link
			href="https://fonts.googleapis.com/css2?family=Crimson+Text&display=swap"
			rel="stylesheet"
		/>
		<title>STS2 Potion Calc</title>
		<style>
			body {
				font-family: "Crimson Text", serif;
			}
		</style>
		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-FPS11MYYXP"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-FPS11MYYXP");
		</script>
	</head>

	<body class="bg-olive-400">
		<div
			id="helpDiv"
			class="hidden fixed top-0 left-0 w-screen h-screen bg-black/50 z-50"
			onclick="hideHelp()"
		>
			<div
				class="bg-olive-400 w-[80%] md:w-[50%] m-auto mt-[10%] p-4 rounded-lg"
			>
				<h1 class="text-xl lg:text-2xl text-center">How to use</h1>
				<p class="lg:text-lg text-center">
					Add nodes based on your map <br />
					Click the potion to attach a potion to the most recent node<br
					/>
					Click nodes or potions to remove them.
				</p>
				<br />
				<h1 class="text-xl lg:text-2xl text-center">
					How does it work?
				</h1>
				<p class="lg:text-lg text-center">
					The chance for a potion at the start of the act is 40%.
					After each combat, the chance increases by 10% if no potion
					was dropped or decreases by 10% if a potion was dropped.
					Elites get a flat 12.5% bonus chance to gain a potion, which
					doesnt carry over anywhere.
				</p>
				<br />
				<p class="lg:text-lg text-center">
					Question marks have a 10% base chance to be a combat. After
					a non-combat event, the chance increases by 10%. After a
					combat, it gets reset to 10%
				</p>
				<br />
				<h1 class="text-xl lg:text-2xl text-center">
					Additional notes
				</h1>
				<p class="lg:text-lg text-center">
					This calculator ignores the chance for events to lead to a
					combat such as "Punch Off", as it is relatively
					insignificant. <br /> However, if you are dropped a potion from
					such an event, you may still append a potion to an event node<br
					/>
					Slay the Spire 2 is still in early access and probabilities may
					change over time. I will update this website to the best of my
					ability.<br />
					This calculator is up to date as of update v0.107.1
				</p>
			</div>
		</div>

		<h1 class="text-2xl lg:text-4xl text-center p-4">
			Slay the Spire 2 Potion Calculator
		</h1>
		<div class="flex justify-center">
			<button
				id="helpBtn"
				class="md:top-5 md:left-10 md:fixed text-3xl hover:text-red-500"
				onclick="showHelp()">INFO</button
			>
		</div>

		<div class="flex flex-col lg:flex-row">
			<div class="lg:w-[50%]">
				<h2 class="text-xl lg:text-2xl text-center">
					Past floors of the act
				</h2>
				<p class="lg:text-lg text-center">
					Include past floors of only this act, and include when the
					potions were dropped.<br /> You can ignore shops, treasures, and
					rest sites. <br />Include events and whether or not they are
					enemy events. Shop and treasure events should be treated as
					normal events
				</p>
				<div
					class="select-none flex flex-wrap lg:flex-row justify-center"
				>
					<div onclick={`createNode(0, '${mapEnemy.src}', true)`}>
						<Mapicon icon={mapEnemy.src} />
					</div>
					<div onclick={`createNode(1, '${mapElite.src}', true)`}>
						<Mapicon icon={mapElite.src} />
					</div>
					<div onclick={`createNode(2, '${mapEvent.src}', true)`}>
						<Mapicon icon={mapEvent.src} />
					</div>
					<div
						onclick={`createNode(3, '${mapEventEnemy.src}', true)`}
					>
						<Mapicon icon={mapEventEnemy.src} />
					</div>
					<div onclick={`addPotion('${potion.src}')`}>
						<Mapicon icon={potion.src} />
					</div>
				</div>
				<div
					class="flex flex-wrap justify-center lg:px-[5%] min-h-20 lg:min-h-40 content-start select-none"
					id="past"
				>
				</div>
				<h2 class="text-xl lg:text-2xl text-center">
					Upcoming floors of the act
				</h2>
				<p class="lg:text-lg text-center">
					Include all floors up until the encounter you are interested
					in
				</p>
				<div class="select-none flex flex-row justify-center">
					<div onclick={`createNode(0, '${mapEnemy.src}', false)`}>
						<Mapicon icon={mapEnemy.src} />
					</div>
					<div onclick={`createNode(1, '${mapElite.src}', false)`}>
						<Mapicon icon={mapElite.src} />
					</div>
					<div onclick={`createNode(2, '${mapEvent.src}', false)`}>
						<Mapicon icon={mapEvent.src} />
					</div>
				</div>

				<div
					class="flex flex-wrap justify-center lg:px-[5%] content-start min-h-20 lg:min-h-40 select-none"
					id="upcoming"
				>
				</div>
				<div class="flex justify-center pb-5">
					<button
						class="text-xl hover:text-red-500"
						onclick="reset()"
					>
						reset
					</button>
				</div>
			</div>

			<div class="lg:w-[50%]">
				<div class="h-[65vh] pr-4">
					<canvas id="potionchart"></canvas>
				</div>

				<p class="lg:text-lg text-center mt-2" id="potchance"></p>
				<p class="lg:text-lg text-center" id="ev"></p>
				<p class="lg:text-lg text-center mb-8 lg:mb-1" id="efloors"></p>
			</div>
		</div>
	</body>
</html>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline>
	let pastlist = [];
	let postlist = [];
	let counter = 0;
	document.addEventListener("DOMContentLoaded", () => {
		display();
	});

	function reset() {
		pastlist = [];
		postlist = [];
		document.getElementById("past").replaceChildren();
		document.getElementById("upcoming").replaceChildren();
		display();
	}
	function createNode(type, src, before) {
		let id = counter;
		counter += 1;
		let place;
		if (before) {
			place = document.getElementById("past");
			if (pastlist.length >= 13) {
				return;
			}
			pastlist.push({ type, id, potion: false });
		} else {
			place = document.getElementById("upcoming");
			if (postlist.length >= 13) {
				return;
			}
			postlist.push({ type, id, potion: false });
		}
		let box = document.createElement("div");
		box.className =
			"h-13 w-19 lg:w-24 lg:h-20 flex items-center justify-center ";

		let img = document.createElement("img");
		img.src = src;
		img.className = "h-13 lg:h-16 hover:brightness-70";

		box.addEventListener("click", () => {
			box.remove();
			pastlist = pastlist.filter((f) => f.id !== id);
			postlist = postlist.filter((f) => f.id !== id);
			display();
		});

		box.appendChild(img);
		place.appendChild(box);
		display();
	}

	function addPotion(src) {
		if (
			pastlist.length == 0 ||
			pastlist[pastlist.length - 1].potion == true
		) {
			return;
		}
		let last = pastlist[pastlist.length - 1];
		let place = document.getElementById("past");
		let lastBox = place.children[place.children.length - 1];

		last.potion = true;
		lastBox.style.position = "relative";

		let img = document.createElement("img");
		img.src = src;
		img.className =
			"absolute -bottom-2 -right-2 h-10 lg:h-13 hover:brightness-50";

		img.addEventListener("click", (e) => {
			e.stopPropagation();
			img.remove();
			last.potion = false;
			display();
		});
		lastBox.appendChild(img);
		display();
	}
	function pastProbabilities() {
		let chance = [[100, 40, 10]];
		for (let node of pastlist) {
			//let dupe = [];
			for (let i of chance) {
				if (node.type == 2 || node.type == 3) {
					if (node.type == 2) {
						i[2] += 10;
					} else {
						i[2] = 10;
					}
				}
				if (node.potion == false && node.type != 2) {
					i[1] += 10;
				} else if (node.type == 0 || node.type == 3 || node.type == 1) {
					i[1] -= 10;
				} else {
					//WHY DID THEY CHANGE IT LITERALLY TEH DAY AFTER???
					// let newdupe = [];
					// newdupe.push(i[0]);
					// newdupe.push(i[1]);
					// newdupe.push(i[2]);
					// i[0] *= 0.875;
					// i[1] -= 10;
					// newdupe[0] *= 0.125;
					// newdupe[1] += 10;
					// dupe.push(newdupe);
				}
			}
			//chance = chance.concat(dupe);
		}
		if (chance[0][1] > 100) {
			chance[0][1] = 100;
		}
		if (chance[0][2] > 100) {
			chance[0][2] = 100;
		}
		if (chance[0][1] < 0) {
			chance[0][1] = 0;
		}
		return chance[0];
	}

	function futureProbabilities() {
		let total = [];
		let past = pastProbabilities();
		let evtracker = {};
		if (past[1] < 0) {
			past[1] = 0;
		}
		total.push(recursive(past, 0, 0, evtracker));
		return [merge(total), evtracker];
	}
	function recursive(chance, quantity, index, ev) {
		ev[index] = (ev[index] ?? 0) + (quantity * chance[0]) / 100;
		if (index >= postlist.length) {
			return { [quantity]: chance[0] };
		}

		let node = postlist[index];
		let weight = chance[0];
		let potionchance = chance[1];
		let enemychance = chance[2];

		switch (node.type) {
			case 0:
				let a = recursive(
					[
						(weight * potionchance) / 100,
						potionchance - 10,
						enemychance,
					],
					quantity + 1,
					index + 1,
					ev,
				);
				let b = recursive(
					[
						(weight * (100 - potionchance)) / 100,
						potionchance + 10,
						enemychance,
					],
					quantity,
					index + 1,
					ev,
				);
				return merge([a, b]);
			case 1:
				//let c = recursive([weight*0.125, potionchance+10,enemychance ],quantity + 1, index+1)
				let d = recursive(
					[
						(weight * (potionchance + 12.5)) / 100,
						potionchance - 10,
						enemychance,
					],
					quantity + 1,
					index + 1,
					ev,
				);
				let x = 87.5 - potionchance;
				if (potionchance + 12.5 > 100) {
					x = 0;
				}
				let e = recursive(
					[(weight * x) / 100, potionchance + 10, enemychance, ev],
					quantity,
					index + 1,
					ev,
				);
				return merge([d, e]);
			case 2:
				let f = recursive(
					[
						(weight * (100 - enemychance)) / 100,
						potionchance,
						enemychance + 10,
					],
					quantity,
					index + 1,
					ev,
				);
				let g = recursive(
					[
						(weight * (enemychance / 100) * potionchance) / 100,
						potionchance - 10,
						10,
					],
					quantity + 1,
					index + 1,
					ev,
				);
				let h = recursive(
					[
						(weight * (enemychance / 100) * (100 - potionchance)) /
							100,
						potionchance + 10,
						10,
					],
					quantity,
					index + 1,
					ev,
				);
				return merge([f, g, h]);
		}
	}
	function merge(odds) {
		let total = {};
		for (let i of odds) {
			for (let [quantity, chance] of Object.entries(i)) {
				if (total[quantity] === undefined) {
					total[quantity] = chance;
				} else {
					total[quantity] += chance;
				}
			}
		}
		return total;
	}

	function expectedFloors(evtracker) {
		let results = {};
		for (let [floor, ev] of Object.entries(evtracker)) {
			let floored = Math.floor(ev);
			if (floored != 0 && results[floored] === undefined) {
				results[floored] = floor;
			}
		}
		return [results, evtracker[postlist.length] ?? 0];
	}

	let potionchart = null;
	function display() {
		//current potion chance
		//potion distribution graph
		//EV
		//Expected first potion, etc.
		let quantity = [];
		let chance = [];
		let future = futureProbabilities();
		let distribution = future[0];
		for (let [q, c] of Object.entries(distribution)) {
			quantity.push(q);

			c = Number(c.toFixed(2));
			chance.push(c);
		}
		let element = document.getElementById("potionchart");

		if (potionchart === null) {
			potionchart = new Chart(element, {
				type: "bar",
				data: {
					labels: quantity,
					datasets: [
						{
							label: "Probability",
							data: chance,
							borderWidth: 1,
							backgroundColor: "#D0202090",
							borderColor: "#D02020B0",
						},
					],
				},
				options: {
					maintainAspectRatio: false,
					scales: {
						x: {
							title: {
								display: true,
								text: "Number of potions",
								color: "black",
							},
							ticks: {
								color: "black",
							},
						},
						y: {
							max: 100,
							beginAtZero: true,
							ticks: {
								color: "black",
								callback: (value) => `${value}%`,
							},
						},
					},
					interaction: {
						mode: "index",
						intersect: false,
					},
					plugins: {
						tooltip: {
							callbacks: {
								color: "black",
								label: (item) => `${item.raw.toFixed(2)}%`,
							},
						},
						legend: {
							labels: {
								color: "black",
							},
						},
					},
				},
			});
		} else {
			potionchart.data.labels = quantity;
			potionchart.data.datasets[0].data = chance;
			potionchart.update();
		}
		let pastchance = pastProbabilities()[1];
		let potiontext = pastchance.toFixed(0) + "%";
		let potlabel = document.getElementById("potchance");
		potlabel.textContent =
			"The current potion drop chance is " + potiontext;
		let evs = expectedFloors(future[1]);
		console.log(evs);
		let efloor = evs[0];
		let ev = evs[1];
		let evlabel = document.getElementById("ev");
		let efloorlabel = document.getElementById("efloors");
		evlabel.textContent =
			"The expected number of potions is " + ev.toFixed(2);
		if (efloor[1] === undefined) {
			efloorlabel.textContent = "You are not expected to get a potion :(";
		} else {
			let text = "";
			let i = 1;
			while (efloor[i] != undefined) {
				if (i == 1) {
					text +=
						"you are expected to get dropped a potion after " +
						efloor[i] +
						" combats or events" +
						"<br>";
				} else {
					text +=
						"You are expected to get " +
						i +
						" potions after " +
						efloor[i] +
						" combats or events" +
						"<br>";
				}
				i += 1;
			}
			efloorlabel.innerHTML = text;
		}
	}

	function showHelp() {
		let helpDiv = document.getElementById("helpDiv");
		helpDiv.classList.remove("hidden");
	}
	function hideHelp() {
		let helpDiv = document.getElementById("helpDiv");
		helpDiv.classList.add("hidden");
	}
</script>
<script is:inline define:vars={{ mapEnemy: mapEnemy }}>
	createNode(0, mapEnemy.src, false);
</script>
