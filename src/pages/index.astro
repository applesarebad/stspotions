---
import "../styles/global.css";
import Mapicon from "../components/mapicon.astro";
import mapElite from "../assets/map_elite.png";
import mapEnemy from "../assets/map_monster.png";
import mapEvent from "../assets/map_unknown.png";
import mapEventEnemy from "../assets/map_unknown_monster.png";
import potion from "../assets/block_potion.png"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>STS2 Potion Calc</title>
	</head>

	<body class="bg-pink-300">
		Past Floors of the act
		<div class="flex flex-row">
			<div onclick={`createNode('enemy', '${mapEnemy.src}', true)`}>
				<Mapicon icon={mapEnemy.src} />
			</div>
			<div onclick={`createNode('elite', '${mapElite.src}', true)`}>
				<Mapicon icon={mapElite.src} />
			</div>
			<div onclick={`createNode('event', '${mapEvent.src}', true)`}>
				<Mapicon icon={mapEvent.src} />
			</div>
			<div onclick={`createNode('eventE', '${mapEventEnemy.src}', true)`}>
				<Mapicon icon={mapEventEnemy.src} />
			</div>
			<div onclick={`createNode('potion', '${potion.src}', true)`}>
				<Mapicon icon={potion.src} />
			</div>
		</div>
		<div class="flex flex-wrap" id="past"></div>
		Upcoming floors
		<div class="flex flex-row">
			<div onclick="createNode('enemy', mapEnemy.src, false)">
				<Mapicon icon={mapEnemy.src} />
			</div>
			<div onclick="createNode('elite', mapElite.src, false)">
				<Mapicon icon={mapElite.src} />
			</div>
			<div onclick="createNode('event', mapEvent.src, false)">
				<Mapicon icon={mapEvent.src} />
			</div>
		</div>

		<div class="flex flex-wrap" id="upcoming"></div>

		<p>dsfojla</p>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script is:inline>
	function createNode(type, src, before) {
		let place = document.getElementById("past");
		if (!before) {
			place = document.getElementById("upcoming");
		}
		let img = document.createElement("img");
		img.src = src;
		if (place != null) {
			place.appendChild(img);
		}
	}
</script>
